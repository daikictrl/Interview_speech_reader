# PromptFlow Teleprompter Environment Variables Template
# Copy this file to .env and insert your private API keys

# OpenRouter (for AI speechwriting and enhancement)
PUBLIC_OPEN_ROUTER_API_KEY=""

# Groq Whisper (for real-time speech-to-text / voice follow)
PUBLIC_GROK_WHISPER_API=""

# Google Gemini (optional backup AI)
PUBLIC_GEMINI_API_KEY=""

# AssemblyAI (optional speech AI)
PUBLIC_ASSEMBLY_AI_API_KEY=""
